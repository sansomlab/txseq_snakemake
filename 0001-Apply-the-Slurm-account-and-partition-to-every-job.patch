+def _slurm_settings(config, config_name):
+    """Return (account, partition) from the config.
+
+    The standard location is the `resources:` section, using the Slurm
+    executor plugin's own names: `slurm_account` and `slurm_partition`.
+    Two older layouts are still honoured, with a warning, so that existing
+    run directories continue to work:
+
+    - `account` / `partition` under `resources:` (earliest templates)
+    - `account` / `partition` under a top-level `slurm:` section
+    """
+    resources = config.get("resources") or {}
+    slurm = config.get("slurm") or {}
+
+    def lookup(standard, older):
+        if resources.get(standard) is not None:
+            return resources[standard], None
+        for section_name, section, key in older:
+            if section.get(key) is not None:
+                return section[key], f"{section_name}.{key}"
+        return None, None
+
+    account, old_account_key = lookup(
+        "slurm_account",
+        [("resources", resources, "account"), ("slurm", slurm, "account")],
+    )
+    partition, old_partition_key = lookup(
+        "slurm_partition",
+        [("resources", resources, "partition"), ("slurm", slurm, "partition")],
+    )
+
+    renames = []
+    if old_account_key:
+        renames.append(f"'{old_account_key}' -> 'resources.slurm_account'")
+    if old_partition_key:
+        renames.append(f"'{old_partition_key}' -> 'resources.slurm_partition'")
+    if renames:
+        print(
+            f"{YELLOW}[WARNING] {config_name} uses older key names. Please "
+            f"rename: {'; '.join(renames)}.{RESET}"
+        )
+
+    account = str(account).strip() if account is not None else None
+    partition = str(partition).strip() if partition is not None else DEFAULT_PARTITION
+    return account or None, partition or DEFAULT_PARTITION
+
