         configpath = Path.cwd().joinpath(f"{args.workflow}.yaml")
         run_snakemake(
             smkpath,
@@ -264,6 +332,8 @@ def main():
             str(args.jobs),
             args.dry,
             str(args.lock).lower(),
+            account,
+            partition,
         )
 
     print(f"{GREEN}Completed successfully!{RESET}")
